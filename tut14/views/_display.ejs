<div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="title">Title</label>
    <div class="col-sm-8">
        <input class="form-control" id="title" value="<%= model.title %>" readonly>
    </div>
</div>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="author">Author</label>
    <div class="col-sm-8">
        <input class="form-control" id="author" value="<%= model.author %>" readonly>
    </div>
</div>
<div class="row mb-3">
    <label class="col-sm-2 col-form-label" for="comments">Comments</label>
    <div class="col-sm-10">
        <textarea class="form-control" id="comments" rows="7" readonly><%= model.comments %></textarea>
    </div>
</div>
