<%- include("_header") %>
<h1>Delete a record?</h1>
<form action="/delete/<%= model.book_id %>" method="post">
    <%- include("_display") %>
    <div class="offset-sm-2">
        <button class="btn btn-danger" type="submit">Delete</button>
        <a class="btn btn-outline-dark" href="/books">Cancel</a>
    </div>
</form>
<%- include("_footer") %>
